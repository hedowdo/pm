  "$defs": {
    "ColumnId": {
      "type": "string",
      "enum": ["ideas", "todo", "in-progress", "review", "done"]
    },
    "BoardColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/ColumnId" },
        "title": { "type": "string", "pattern": "\\S" }
      }
    },
    "KanbanCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "details", "columnId"],
      "properties": {
        "id": { "type": "string", "pattern": "\\S" },
        "title": { "type": "string", "pattern": "\\S" },
        "details": { "type": "string" },
        "columnId": { "$ref": "#/$defs/ColumnId" }
      }
    },
    "BoardState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "cards"],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "prefixItems": [
            {
              "allOf": [
                { "$ref": "#/$defs/BoardColumn" },
                { "properties": { "id": { "const": "ideas" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/BoardColumn" },
                { "properties": { "id": { "const": "todo" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/BoardColumn" },
                { "properties": { "id": { "const": "in-progress" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/BoardColumn" },
                { "properties": { "id": { "const": "review" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/BoardColumn" },
                { "properties": { "id": { "const": "done" } } }
              ]
            }
          ],
          "items": false
        },
        "cards": {
          "type": "array",
          "items": { "$ref": "#/$defs/KanbanCard" },
          "x-uniqueBy": "id"
        }
      }
    }
  }
}
