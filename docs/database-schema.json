{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kanban-studio.local/schemas/board-state.json",
  "title": "Kanban Studio BoardState",
  "$ref": "#/$defs/BoardState",
  "x-sqlite": {
    "foreignKeys": true,
    "tables": [
      {
        "name": "users",
        "columns": [
          { "name": "id", "type": "INTEGER", "nullable": false, "primaryKey": true },
          { "name": "username", "type": "TEXT", "nullable": false }
        ],
        "constraints": [
          { "type": "unique", "columns": ["username"] },
          { "type": "check", "expression": "length(trim(username)) > 0" }
        ]
      },
      {
        "name": "boards",
        "columns": [
          { "name": "id", "type": "INTEGER", "nullable": false, "primaryKey": true },
          { "name": "user_id", "type": "INTEGER", "nullable": false },
          { "name": "state_json", "type": "TEXT", "nullable": false }
        ],
        "constraints": [
          { "type": "unique", "columns": ["user_id"] },
          {
            "type": "foreignKey",
            "columns": ["user_id"],
            "references": { "table": "users", "columns": ["id"] },
            "onDelete": "CASCADE"
          },
          { "type": "check", "expression": "json_valid(state_json)" }
        ]
      }
    ],
    "createSql": [
      "PRAGMA foreign_keys = ON",
      "CREATE TABLE IF NOT EXISTS users (id INTEGER PRIMARY KEY, username TEXT NOT NULL UNIQUE CHECK (length(trim(username)) > 0))",
      "CREATE TABLE IF NOT EXISTS boards (id INTEGER PRIMARY KEY, user_id INTEGER NOT NULL UNIQUE REFERENCES users(id) ON DELETE CASCADE, state_json TEXT NOT NULL CHECK (json_valid(state_json)))"
    ],
    "initialization": [
      "Insert username 'user' with INSERT OR IGNORE",
      "Select that user's id",
      "Insert the seed BoardState with INSERT OR IGNORE so an existing board is never overwritten"
    ],
    "ownership": {
      "source": "authenticated session username",
      "read": "Join boards to users and filter by users.username",
      "replace": "Update boards.state_json through the user id selected by username",
      "browserSuppliedIdentityAllowed": false
    },
    "replacementTransaction": [
      "Validate and canonicalize the complete BoardState before opening the write transaction",
      "BEGIN IMMEDIATE",
      "Update exactly one board selected through the authenticated username",
      "COMMIT on success; ROLLBACK on any error"
    ]
  },
  "x-api": {
    "get": {
      "method": "GET",
      "path": "/api/board",
      "authentication": "required",
      "response": "BoardState"
    },
    "replace": {
      "method": "PUT",
      "path": "/api/board",
      "authentication": "required",
      "request": "BoardState",
      "response": "canonical persisted BoardState"
    },
    "identityInput": "none"
  },
  "x-validationInvariants": [
    "Reject unknown fields at every object level",
    "Require the five fixed columns exactly once and in the declared order",
    "Trim column titles, card ids, card titles, and card details before persistence",
    "Reject blank column titles, card ids, and card titles after trimming",
    "Require unique card ids",
    "Require every card columnId to reference a fixed column",
    "Validate after every database read and before every database write"
  ],
  "x-seed": {
    "user": { "id": 1, "username": "user" },
    "board": {
      "id": 1,
      "userId": 1,
      "state": {
        "columns": [
